# Create user
curl -X POST http://localhost:2000/api/v1/signup \
  -H "Content-Type: application/json" \
  -d '{
    "firstName": "John",
    "lastName": "Doe",
    "email": "john.doe@example.com",
    "password": "securePassword123"
}'

# Login test
curl -X POST http://localhost:2000/api/v1/login \
  -H "Content-Type: application/json" \
  -d '{"email":"john.doe@example.com","password":"securePassword123"}' \
  -c cookies.txt

# A cookies.txt file must be generated and should countain a Auth Bearer Token

# GetAllUsers Call
# THe query string can be removed is necessary
curl -X GET "http://localhost:2000/api/v1/getAllUser?accountTypes=Admin,HOD&departments=CSE,ECE" \
  -H "Authorization: Bearer YOUR_TOKEN"

# Logout test
curl -X POST http://localhost:2000/api/v1/logout \
  -H "Authorization: Bearer TOKEN" \
  -H "Content-Type: application/json"




# Resetting Passwords
# There are 2 way through which password can be reset
# 1. OTP Autentication (Forgot Password)
curl -X POST http://localhost:2000/api/v1/generate-otp \
-H "Content-Type: application/json" \
-d '{"email": "pranavakp2004@gmail.com"}'


curl -X POST http://localhost:2000/api/v1/verify-otp \
-H "Content-Type: application/json" \
-d '{"email": "pranavakp2004@gmail.com", "otp": "495937"}'

curl -X POST http://localhost:2000/api/v1/reset-password-with-otp \
-H "Content-Type: application/json" \
-d '{"email": "pranavakp2004@gmail.com", "newPassword": "87654321"}'

# 2.Change Password for Authenticated Users 
curl -X POST http://localhost:2000/api/v1/change-password -H "Content-Type: application/json" -d '{
"email": "pranavakp2004@gmail.com",
"currentPassword": "12345678",
"newPassword": "87654321"
}'

# Getting individual profile details
# 1. Using token value
curl -X GET http://localhost:2000/api/v1/profile \
  -H "Authorization: Bearer TOKEN" \
  -H "Content-Type: application/json"
# 2. Using token stored in a file
curl -X GET http://localhost:2000/api/v1/profile \
  -b cookies.txt \
  -H "Content-Type: application/json"


# Udating Profiles
# 1. Update by Staff
# This api can only be called once iff there are null or undefined fields in the DB entry. Those fields can be updated
curl -X PATCH http://localhost:2000/api/v1/update-own-profile   -H "Content-Type: application/json"   -H "Authorization: Bearer TOKEN"   -d '{
    "employeeId": "96",
    "phone": "7019367895",
    "gender": "Female"
  }'
# 2. Update by admin
# This call can be made only by admin or Principal, allows changes to all fields
# Target is identified using the id field
curl -X PATCH http://localhost:2000/api/v1/admin-update-profile \
  -H "Authorization: Bearer TOKEN" \
  -H "Content-Type: application/json" \
  -d '{
    "id": "687b3ad366c8e63a8d6fe0cb",
    "email": "1rn22cs118.pranavakp@rnsit.ac.in",
    "firstName": "Pranava",
    "lastName": "K P",
    "accountType": "Staff",
    "department": "ME",
    "employeeId": "96",
    "gender": "Female",
    "phone": "7019367895"
  }'

